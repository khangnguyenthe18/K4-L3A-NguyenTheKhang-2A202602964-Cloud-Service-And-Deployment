# CP2 — .dockerignore
# Các file và thư mục KHÔNG copy vào Docker image

# Secrets — TUYỆT ĐỐI không leak vào image
.env
.env.*
!.env.example
*.pem
*.key

# Git
.git
.gitignore

# Python & môi trường ảo
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Tests & docs (không cần thiết trong runtime image)
tests/
*.md
